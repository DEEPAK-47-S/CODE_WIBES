# =========================
# CODE WIBES .gitignore
# =========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Environment variables (NEVER commit)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
*.tsbuildinfo

# Logs
*.log
logs/

# Database
*.sql.bak

# Testing
.coverage
htmlcov/
.pytest_cache/

# Alembic
alembic/versions/__pycache__/

# Execution workspaces (may contain generated code)
execution/workspaces/*/
execution/sandbox/*/
